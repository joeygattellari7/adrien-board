# Password protecting the whole dashboard (single shared password, no per-user accounts)
DASHBOARD_PASSWORD=

# Meta (Facebook/Instagram) Marketing API
# For Creative Factory campaign creation, this token needs "ads_management"
# permission, not just "ads_read" (the reporting-only scope used elsewhere).
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=937731679434253
META_PAGE_ID=

# Anthropic API — optional. Without it, Creative Factory's ad copy generator
# falls back to fixed templates instead of AI-written variations.
ANTHROPIC_API_KEY=

# Google Ads API
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Bite Business (bitebusiness.com): blocked for now — API access is only on
# the "The Lot" plan, and Juliano's account is on "Main". No env vars to set
# here until the plan is upgraded and Bite Business confirms a reporting API.
