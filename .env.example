# Password protecting the whole dashboard (single shared password, no per-user accounts)
DASHBOARD_PASSWORD=

# Meta (Facebook/Instagram) Marketing API
# For Creative Factory campaign creation, this token needs "ads_management"
# permission, not just "ads_read" (the reporting-only scope used elsewhere).
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=937731679434253
META_PAGE_ID=

# Anthropic API — optional. Without it, Creative Factory's ad copy generator
# falls back to fixed templates instead of AI-written variations.
ANTHROPIC_API_KEY=

# OpenAI API — optional, only used by Content Studio's "Generate an image
# with AI" button. No fallback: without this set, that button errors instead
# of degrading (an image can't be faked with a template the way text can).
OPENAI_API_KEY=

# Content Studio's Scheduler and Adrien Brain's content library — optional.
# Without these, both fall back to in-memory storage that doesn't survive a
# restart/cold start.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Video storage for the content library and video resizing — optional, but
# required for either. Add a Blob store from the Vercel project's Storage
# tab, which sets this automatically. Without it, video uploads to the
# library error clearly, and Content Studio's video repurposing falls back
# to a "resize target" note instead of an actual resized file.
BLOB_READ_WRITE_TOKEN=

# Google Ads API
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Bite Business (bitebusiness.com): blocked for now — API access is only on
# the "The Lot" plan, and Juliano's account is on "Main". No env vars to set
# here until the plan is upgraded and Bite Business confirms a reporting API.
